mainmenu "smolclaw configuration"

menu "Channels"

config SC_ENABLE_TELEGRAM
	bool "Telegram channel (long-polling bot)"
	default y
	select NEED_PTHREADS
	help
	  Enable the Telegram channel. Requires a bot token in config.
	  Uses long-polling + REST API in a dedicated thread.

config SC_ENABLE_DISCORD
	bool "Discord channel (Gateway WebSocket)"
	default y
	select NEED_OPENSSL
	select NEED_PTHREADS
	help
	  Enable the Discord channel. Requires a bot token in config.
	  Uses a custom WebSocket client over TLS (OpenSSL).

config SC_ENABLE_IRC
	bool "IRC channel (TCP/TLS socket)"
	default y
	select NEED_OPENSSL
	select NEED_PTHREADS
	help
	  Enable the IRC channel with optional TLS.
	  Responds to nick highlights and DMs.

config SC_ENABLE_SLACK
	bool "Slack channel (Socket Mode WebSocket)"
	default y
	select NEED_OPENSSL
	select NEED_PTHREADS
	help
	  Enable the Slack channel via Socket Mode (WSS receive)
	  and Web API (send). Requires bot_token and app_token.

config SC_ENABLE_WEB
	bool "Web channel (REST API + embedded chat)"
	default y
	select NEED_PTHREADS
	help
	  Enable the Web channel with HTTP REST API and embedded
	  chat UI. Runs on its own event loop thread.
	  Optional built-in TLS when channels.web.tls_cert and
	  tls_key are set (needs OpenSSL); otherwise use a
	  reverse proxy (nginx/caddy) for HTTPS.

config SC_ENABLE_X
	bool "X (Twitter) channel (REST polling)"
	default n
	select NEED_OPENSSL
	select NEED_PTHREADS
	help
	  Enable the X (Twitter) channel. Requires API credentials in config.
	  Polls for mentions, responds as tweets. Optional DM support.
	  Uses OAuth 1.0a with HMAC-SHA1 (OpenSSL).
	  Requires Pay-Per-Use or Basic API tier (Free tier cannot poll mentions).

config SC_ENABLE_SIGNAL
	bool "Signal channel (via external signal-cli daemon)"
	default n
	select NEED_PTHREADS
	help
	  Enable the Signal channel. smolclaw does NOT implement the Signal
	  protocol itself; it talks JSON-RPC to a separately running signal-cli
	  daemon (or the bbernhard/signal-cli-rest-api container) over HTTP.
	  Text-only DMs + groups, polling receive.

	  Recommended: a dedicated bot phone number + dm_policy="pairing".

endmenu

menu "Tools"

config SC_ENABLE_GIT
	bool "Git tool (subcommand allowlist, fork+exec)"
	default y
	help
	  Enable the git tool for safe git operations.
	  Uses a subcommand allowlist and fork+execvp (no shell).

config SC_ENABLE_GITEA
	bool "Gitea API tool (repos, issues, PRs)"
	default n
	help
	  Enable the gitea tool for creating repos, issues, and PRs
	  via the Gitea REST API. Requires API credentials in config.

config SC_ENABLE_CAMERA
	bool "Camera tool (capture + vision describe)"
	default n
	help
	  Enable the camera tool: capture stills via an external command
	  (e.g. rpicam-still), list motion-daemon event captures, and
	  describe images through a remote vision model (ollama API).
	  For camera-equipped embedded deployments.

config SC_ENABLE_WEB_TOOLS
	bool "Web search and fetch tools"
	default y
	help
	  Enable web_search (Brave/SearXNG/DuckDuckGo) and web_fetch tools.
	  Includes SSRF protection with private IP blocking.

config SC_ENABLE_X_TOOLS
	bool "X (Twitter) read tools (get_tweet, search, etc.)"
	default n
	select NEED_OPENSSL
	help
	  Enable X API read tools: x_get_tweet, x_get_thread, x_search, x_get_user.
	  Requires API credentials in config. Independent of the X channel.
	  Uses OAuth 1.0a (OpenSSL). Read-only — never posts.

config SC_ENABLE_VOICE
	bool "Voice transcription (Groq Whisper)"
	default n
	help
	  Enable voice message transcription via Groq Whisper API.
	  Used by Telegram voice messages and Discord audio attachments.

config SC_ENABLE_BACKGROUND
	bool "Background process management tools"
	default y
	help
	  Enable exec_background, bg_poll, and bg_kill tools for
	  running and managing background processes.

config SC_ENABLE_CODE_GRAPH
	bool "Code dependency graph tool"
	default n
	help
	  Enable the code_graph tool for analyzing import dependencies and
	  C/C++ symbols (for researcher Drill-down).
	  Regex-based extraction from JS/TS, Python, C/C++, Go, Rust (graphs)
	  plus lightweight C symbol extraction (funcs, structs, defines, etc.).
	  Actions: build, query, stats, cycles, symbols (with path/name_filter).

endmenu

menu "Output"

config SC_ENABLE_TEE
	bool "Tee-on-truncation (save full output to disk)"
	default y
	help
	  Save full tool output to disk when truncated, so the LLM
	  can read it later via read_file instead of re-running commands.

config SC_ENABLE_OUTPUT_FILTER
	bool "Output compression for common CLI tools"
	default n
	select SC_ENABLE_TEE
	help
	  Compress verbose output from cargo test, git status, pytest,
	  etc. before it enters the LLM context. Requires tee.

endmenu

menu "Analytics"

config SC_ENABLE_ANALYTICS
	bool "SQLite-backed token/cost analytics"
	default n
	help
	  Time-series tracking of LLM usage: tokens, tool calls, latency.
	  Stored in {workspace}/state/analytics.db. Complements cost.c.

config SC_ENABLE_HOST_METRICS
	bool "Retained host metrics (SQLite) + host_trend tool"
	default y
	help
	  Persist periodic host samples (load, memory, FDs, temperature)
	  to {workspace}/state/host_metrics.db and enable the host_trend
	  analysis tool. Pulls the SQLite amalgamation (~700 KB) into the
	  binary — disable for minimal/embedded builds. The host_status
	  and host_inventory tools do not need this.

endmenu

menu "Services"

config SC_ENABLE_CRON
	bool "Cron scheduling service"
	default y
	help
	  Enable the cron tool and scheduling service.
	  The LLM can add, list, and remove scheduled jobs.

config SC_ENABLE_HEARTBEAT
	bool "Heartbeat service"
	default y
	help
	  Enable periodic idle prompts. Sends a configurable prompt
	  to the agent at a set interval when idle.

config SC_ENABLE_SPAWN
	bool "Subagent spawning tool"
	default y
	help
	  Enable the spawn tool for creating subagent instances
	  on separate sessions. Depth limited to 3.

config SC_ENABLE_DELEGATE
	bool "Delegate tool (agent-to-agent task routing)"
	default n
	help
	  Enable the delegate tool for sending tasks to other smolclaw
	  agents via their Web channel REST API. Requires delegation
	  targets in config.json.

config SC_ENABLE_MEMORY_SEARCH
	bool "Memory full-text search (SQLite FTS5)"
	default y
	help
	  Enable full-text search across memory files via SQLite FTS5.
	  Adds the memory_search tool for keyword-based retrieval.
	  Uses a vendored SQLite amalgamation (no external dependency).
	  When disabled, the amalgamation is built without SQLITE_ENABLE_FTS5
	  (smaller sqlite3 when host metrics or analytics still link SQLite).

config SC_ENABLE_PROJECT_MEMORY
	bool "Project memory + repo_search (workspace code index)"
	default n
	help
	  Add the repo_search tool: a per-workspace code index
	  ({SMOLCLAW_HOME}/indexes/<hash>.json) over source files with
	  lightweight term/symbol/import extraction, plus ranked search.
	  Distinct from memory_search (facts) and session_search (chats).
	  Index lives under SMOLCLAW_HOME, never inside the user's repo.

config SC_ENABLE_SESSION_SEARCH
	bool "Global session search (FTS5 over stored sessions)"
	default n
	depends on SC_ENABLE_MEMORY_SEARCH
	help
	  Add the session_search tool: full-text search across all stored
	  session transcripts under {SMOLCLAW_HOME}/sessions/ (e.g. "did we
	  discuss X last week?") plus a recent-session list. Reuses the SQLite
	  FTS5 index machinery from memory search; the index is built on first
	  search (deferred). Distinct from memory_search (long-term facts vs
	  conversation recall).

endmenu

menu "Integration"

config SC_ENABLE_STREAMING
	bool "SSE streaming for LLM responses"
	default y
	help
	  Enable Server-Sent Events streaming for real-time
	  LLM output display.

config SC_ENABLE_MCP
	bool "MCP client for external tool servers"
	default y
	help
	  Enable the Model Context Protocol client.
	  Extends tools via external JSON-RPC 2.0 servers
	  communicating over stdin/stdout.

config SC_ENABLE_MCP_SERVER
	bool "MCP server mode (expose tools via stdio)"
	default y
	help
	  Enable the MCP server mode. Exposes smolclaw's tool
	  registry as a JSON-RPC 2.0 server on stdin/stdout,
	  usable from Claude Code, Cursor, etc.
	  Lightweight: no LLM, agent, bus, or channels.

config SC_ENABLE_MOA
	bool "Mixture of Agents (MoA-lite) virtual provider"
	default n
	help
	  Enable the virtual 'moa' provider. On each LLM call, reference
	  models run first (no tools, trimmed context); their outputs are
	  injected for an aggregator model that acts as the real model.
	  Config-json presets, parallel reference cap of 3, optional
	  local_only policy. Multiplies API cost per iteration — opt-in.

endmenu

menu "Security"

config SC_STRICT_SECURITY
	bool "Strict security defaults (fail-closed)"
	default n
	help
	  When enabled, all security-sensitive defaults become fail-closed:
	  - Channel DM policy defaults to "allowlist" (deny unknown senders)
	  - Exec tool defaults to allowlist mode (only pre-approved commands)
	  - External channels are quarantined unless security is configured
	    (allow_from or non-open dm_policy required; Web needs bearer token)
	  - Config version mismatch (newer config, older binary) blocks startup

	  When disabled (default), behavior is backward-compatible:
	  - DM policy defaults to "open"
	  - Exec allows all non-denied commands
	  - Channels start with warnings only

config SC_ENABLE_VAULT
	bool "Encrypted API key vault (AES-256-GCM)"
	default y
	select NEED_OPENSSL
	help
	  Enable the encrypted vault for storing API keys and secrets.
	  Uses AES-256-GCM with PBKDF2 key derivation (OpenSSL).
	  Config references secrets as vault://key_name.
	  Adds the 'vault' CLI subcommand.

endmenu

menu "Updates"

config SC_ENABLE_UPDATER
	bool "Self-update service"
	default y
	select NEED_OPENSSL
	help
	  Transport-agnostic self-update: check, download, verify (SHA-256),
	  atomic binary replacement. HTTP transport built-in.

endmenu

# Hidden dependency symbols — auto-selected by features that need them
config NEED_OPENSSL
	bool
	default n

config NEED_PTHREADS
	bool
	default n
